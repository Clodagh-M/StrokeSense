@inherits LayoutComponentBase
@using StrokeSense.UI.Themes

<MudThemeProvider Theme="StrokeSenseTheme.Theme" @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Primary">
        <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Class="mr-3" />
        <MudText Typo="Typo.h6">StrokeSense</MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.85);">
            Not a diagnosis
        </MudText>
    </MudAppBar>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
